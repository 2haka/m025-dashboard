# Copy to backend/.env and adjust.

# HTTP + WebSocket port for the dashboard (same port the mock uses, so the frontend needs no change)
PORT=4000

# MQTT broker (Mosquitto). Use the IP of the laptop that runs Mosquitto.
# Same laptop as this backend:  mqtt://localhost:1883
# Osama's laptop on the hotspot: mqtt://172.20.10.4:1883
MQTT_URL=mqtt://localhost:1883

# MongoDB. The backend keeps running (live monitoring) if MongoDB is down, but history/logging stop.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=m025

# A helmet with no MQTT message for this long is LINK_LOST (ms). Matches the tool ESP32 fail-safe (3 s).
LINK_TIMEOUT_MS=3000

# Unchanged heartbeats are pushed to the dashboard at most this often per helmet (ms).
# State changes are always pushed immediately.
HEARTBEAT_PUSH_MS=500

# After a HELMET_REMOVED violation, a relay report of '0' within this window confirms TOOL_DISABLED (ms).
RELAY_CONFIRM_MS=5000

# 1 = print a per-topic summary of raw MQTT traffic every 2 s (useful on integration day).
LOG_MQTT=1
